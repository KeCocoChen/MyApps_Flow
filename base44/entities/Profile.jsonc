{
  "name": "Profile",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "is_premium": {
      "type": "boolean",
      "default": false
    },
    "followers_count": {
      "type": "number",
      "default": 0
    },
    "following_count": {
      "type": "number",
      "default": 0
    },
    "posts_count": {
      "type": "number",
      "default": 0
    },
    "mbti": {
      "type": "string"
    },
    "mbti_completed": {
      "type": "boolean",
      "default": false
    },
    "feed_mode": {
      "type": "string",
      "enum": [
        "standard",
        "tiktok"
      ],
      "default": "standard"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "personal",
        "enterprise"
      ],
      "default": "personal"
    },
    "is_mutual_follow": {
      "type": "boolean",
      "default": false
    },
    "last_contacted": {
      "type": "string"
    }
  },
  "required": [
    "display_name",
    "username"
  ]
}