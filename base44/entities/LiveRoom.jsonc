{
  "name": "LiveRoom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "talking",
        "texting"
      ]
    },
    "host_name": {
      "type": "string"
    },
    "host_avatar": {
      "type": "string"
    },
    "participants_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "cover_image": {
      "type": "string"
    },
    "max_participants": {
      "type": "number",
      "default": 50
    }
  },
  "required": [
    "name",
    "type"
  ]
}